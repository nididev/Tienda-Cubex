# Base de datos MySQL de CUBEX. Usa las credenciales de tu servicio actual.
DATABASE_URL=mysql+pymysql://USUARIO:CONTRASENA@HOST:3306/tienda_db?charset=utf8mb4
APP_PORT=3025
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://cubex-tienda.netlify.app

# --- Agregado para inventario automático, logística y seguridad ---
JWT_SECRET=MISMO_VALOR_QUE_microservicio-login
JWT_ISSUER=microservicio-login

# --- Envío del ticket por correo (elige una opción) ---
# Opción A (en internet / Railway): API de Brevo por HTTPS.
# BREVO_API_KEY=xkeysib-...
# MAIL_FROM=correo-verificado-en-brevo@gmail.com
# Opción B (en tu computadora): SMTP de Gmail con contraseña de aplicación.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=tucorreo@gmail.com
# SMTP_PASSWORD=contrasena_de_aplicacion
